# ---------------------------------------------------------
# Server configuration
# ---------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------
# Local MongoDB connection
# ---------------------------------------------------------
# This database is used when you run the application normally.
MONGO_URI=mongodb://127.0.0.1:27017/student_management

# ---------------------------------------------------------
# MongoDB Atlas example (optional)
# ---------------------------------------------------------
# Replace the placeholders with your Atlas username, password,
# cluster address, and database name. Never commit real values.
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/student_management?retryWrites=true&w=majority

# ---------------------------------------------------------
# Automated test database
# ---------------------------------------------------------
# Jest uses this separate database and deletes only this database.
# The database name must end with "_test" as a safety measure.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/student_management_test
